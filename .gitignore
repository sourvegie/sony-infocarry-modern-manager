.DS_Store
**/.DS_Store

# Generated project output
tmp/
tests/output/*
!tests/output/.gitkeep
samples/generated/*
!samples/generated/.gitkeep
# P15-001 is a sanitized, reviewable source fixture rather than runtime output.
!samples/generated/P15-001-native-multi-chapter-txt/
!samples/generated/P15-001-native-multi-chapter-txt/**
# P15-002 is a sanitized, reviewable source fixture rather than runtime output.
!samples/generated/P15-002-modern-multi-chapter-txt/
!samples/generated/P15-002-modern-multi-chapter-txt/**
# P16-001 is a sanitized, reviewable source fixture rather than runtime output.
!samples/generated/P16-001-native-mixed-txt-bmp/
!samples/generated/P16-001-native-mixed-txt-bmp/**

# Evidence and live-operation material (keep outside this source repository)
/evidence/
/backups/
/device-backups/
/captures/
/usbsnifferlogs/
/legacy/
/live-evidence/
/screenshots/
support/windows2000-timestamp/logs/
*.usblog
*.pcap
*.pcapng
analysis/**/range-*.bin

# Original or proprietary distribution material
*.exe
*.dll
*.sys
*.msi
*.iso
*.dmg
*.pkg
*.whl
*.zip
*.tar.gz
*.tgz
*.7z
*.rar

# Credentials and signing material
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.mobileprovision

# Python cache and local environments
__pycache__/
*.py[cod]
.venv/
venv/

# Build and packaging output
build/
dist/
*.egg-info/
*.spec
